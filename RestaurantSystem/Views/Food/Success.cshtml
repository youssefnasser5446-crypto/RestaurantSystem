@model RestaurantSystem.Models.Order

<div class="container mt-5 text-center" dir="rtl">
    <div class="p-5 bg-light rounded shadow">
        <h1 class="display-3 text-success">✅ شكراً لثقتك بنا!</h1>

        @if (Model != null)
        {
            <p class="lead">يا @Model.CustomerName، أوردرك رقم (#@Model.Id) مسجل لدينا حالياً.</p>
            <hr>
            <p class="fw-bold">سعيدين بك وبزيارتك لمطعمنا، نتمنى لك وجبة شهية!</p>

            <div class="mt-4">
                <h4 class="text-muted">حالة طلبك الآن:</h4>
                <div class="display-6 mb-3 @(Model.Status == "تم التوصيل" ? "text-success" : "text-warning")">
                    <strong>@Model.Status</strong>
                </div>

                @* منطق زرار الإلغاء *@
                @if (Model.Status != "جاري التجهيز" && Model.Status != "تم التوصيل")
                {
                    <div class="alert alert-info d-inline-block p-3">
                        <p class="mb-2 small text-dark">يمكنك إلغاء الطلب الآن ما دام لم يبدأ تجهيزه بعد.</p>
                        <form asp-controller="Food" asp-action="CancelOrder" method="post">
                            <input type="hidden" name="orderId" value="@Model.Id" />
                            <button type="submit" class="btn btn-danger" onclick="return confirm('هل أنت متأكد من رغبتك في إلغاء هذا الطلب؟')">
                                <i class="bi bi-x-circle"></i> إلغاء الطلب
                            </button>
                        </form>
                    </div>
                }
                else if (Model.Status == "جاري التجهيز")
                {
                    <div class="alert alert-warning d-inline-block p-3">
                        <p class="mb-0 fw-bold"><i class="bi bi- clock-history"></i> نعتذر، لا يمكن إلغاء الطلب لأنه دخل مرحلة التجهيز فعلياً.</p>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="lead">لا توجد طلبات حالية مسجلة باسمك.</p>
        }

        <br />
        <div class="mt-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">العودة للرئيسية</a>
        </div>
    </div>
</div>

@* إضافة مكتبة الأيقونات لو مش موجودة في الـ Layout *@
@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}