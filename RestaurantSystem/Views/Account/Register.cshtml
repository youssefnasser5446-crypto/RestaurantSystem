@model RestaurantSystem.Models.User
@{
    ViewData["HideNav"] = true;
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 border p-4 shadow-sm">
            <h2 class="text-center text-primary">إنشاء حساب جديد</h2>
            <hr />

            @* 1. تحديد الكنترولر في الفورمة *@
            <form asp-controller="Account" asp-action="Register" method="post">
                <div class="form-group mb-3">
                    <label class="form-label">الإسم الكامل</label>
                    <input asp-for="Name" class="form-control" placeholder="اكتب اسمك هنا" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">الإيميل الخاص بالمطعم</label>
                    <input asp-for="Email" class="form-control" placeholder="example@restaurant.com" />
                    <small class="text-muted">يجب أن ينتهي بـ @@restaurant.com</small>
                    <br />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">كلمة المرور</label>
                    <input asp-for="Password" type="password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success w-100">تسجيل الآن</button>
            </form>

            <div class="mt-3 text-center">
                @* 2. تحديد الكنترولر في لينك العودة للوجن *@
                <a asp-controller="Account" asp-action="Login">عندك حساب؟ سجل دخول من هنا</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}