@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@inject IHttpContextAccessor HttpContextAccessor
@using RestaurantSystem.Models
@inject ApplicationDbContext _db

<!DOCTYPE html>
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    // تعديل: كشف صفحات الإدارة بشكل أدق
    bool isAdminPage = (currentController == "AdminOrder");

    // شرط صفحات الدخول والتسجيل
    bool isAuthPage = (currentAction == "Login" || currentAction == "Register");

    var userEmail = User.Identity?.Name;
    RestaurantSystem.Models.Order trackOrder = null;

    // البحث عن طلب نشط فقط لو مش في صفحة أدمن أو دخول
    if (!string.IsNullOrEmpty(userEmail) && !isAdminPage && !isAuthPage)
    {
        trackOrder = _db.Orders
                        .Where(o => o.UserEmail == userEmail && o.Status != "تم التوصيل")
                        .OrderByDescending(o => o.Id)
                        .FirstOrDefault();
    }

    bool showTracking = (trackOrder != null && !isAdminPage && !isAuthPage);
}
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>مطعمنا - @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    @if (!isAuthPage)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container">
                    @* 1. اللوجو: يظهر للكل لكن يوجه لمكان مختلف *@
                    @if (isAdminPage)
                    {
                        <a class="navbar-brand fw-bold text-dark" asp-controller="AdminOrder" asp-action="Index">🛠️ لوحة الإدارة</a>
                    }
                    else
                    {
                        <a class="navbar-brand fw-bold text-primary" asp-controller="Home" asp-action="Index">🍎 مطعمنا</a>
                    }

                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between text-end">
                        <ul class="navbar-nav flex-grow-1">
                            @if (!isAdminPage)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">الرئيسية</a>
                                </li>

                                @if (showTracking)
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-danger fw-bold" asp-controller="Food" asp-action="Success" asp-route-id="@trackOrder.Id">
                                            <i class="bi bi-geo-alt-fill"></i> تتبع طلبك (#@trackOrder.Id)
                                        </a>
                                    </li>
                                }
                            }
                            else
                            {
                                @* روابط تظهر فقط للأدمن في النافبار *@
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-bold" asp-controller="AdminOrder" asp-action="Index">إدارة الطلبات</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="AdminOrder" asp-action="MonthlySales">تقارير المبيعات</a>
                                </li>
                            }
                        </ul>

                        <ul class="navbar-nav">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <li class="nav-item">
                                    <span class="nav-link text-muted">أهلاً @(isAdminPage ? "مدير المطعم" : User.Identity.Name)</span>
                                </li>
                                <li class="nav-item">
                                    <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="nav-link btn btn-link text-danger border-0">خروج</button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">دخول</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }

    <div class="container">
        @* التنبيه يظهر فقط للمستخدم العادي *@
        @if (showTracking)
        {
            <div class="alert alert-warning text-center shadow-sm border-warning">
                يا <strong>@User.Identity.Name</strong>، عندك طلب شغال برقم #@trackOrder.Id حالته: <span class="badge bg-danger">@trackOrder.Status</span>
                <a asp-controller="Food" asp-action="Success" asp-route-id="@trackOrder.Id" class="btn btn-sm btn-dark ms-2">التفاصيل</a>
            </div>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>