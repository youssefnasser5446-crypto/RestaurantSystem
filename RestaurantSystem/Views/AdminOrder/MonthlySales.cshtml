@model IEnumerable<RestaurantSystem.Models.MonthlySalesViewModel>
@{
    int selectedYear = ViewBag.SelectedYear;
}

<div class="container mt-4 text-end" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold mb-0 text-dark">📊 تقرير مبيعات @selectedYear</h2>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2">⬅️ عودة لإدارة الطلبات</a>
        </div>

        <div class="btn-group shadow-sm">
            <a href="?year=@(selectedYear - 1)" class="btn btn-outline-dark">السنة السابقة</a>
            <a href="?year=@(DateTime.Now.Year)" class="btn btn-primary">السنة الحالية</a>
            <a href="?year=@(selectedYear + 1)" class="btn btn-outline-dark">السنة القادمة</a>
        </div>
    </div>

    <div class="row">
        @for (int m = 1; m <= 12; m++)
        {
            // تجميع بيانات الشهر ده بالظبط
            var monthData = Model.Where(x => x.Month == m).ToList();
            var totalMonthAmount = monthData.Sum(s => s.TotalRevenue);

            <div class="col-md-3 mb-4">
                <div class="card h-100 shadow-sm border-0 @(monthData.Any() ? "bg-white" : "bg-light")">
                    <div class="card-header text-center @(monthData.Any() ? "bg-success text-white" : "bg-secondary text-white") fw-bold">
                        شهر @m
                    </div>
                    <div class="card-body text-center d-flex flex-column justify-content-center" style="min-height: 130px;">
                        @if (monthData.Any())
                        {
                            <h4 class="fw-bold text-success mb-1">@totalMonthAmount.ToString("N0") <small class="fs-6 text-muted">جنية</small></h4>
                            <button class="btn btn-sm btn-link text-decoration-none" data-bs-toggle="modal" data-bs-target="#modal@m">
                                🔍 تفاصيل الأصناف
                            </button>
                        }
                        else
                        {
                            <p class="text-muted small mb-0">لا توجد بيانات</p>
                        }
                    </div>
                </div>
            </div>

            @if (monthData.Any())
            {
                <div class="modal fade" id="modal@m" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header bg-success text-white">
                                <h5 class="modal-title">أصناف شهر @m سنة @selectedYear</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body p-0">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr class="text-center"><th>الصنف</th><th>الكمية</th><th>الإيراد</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in monthData)
                                        {
                                            <tr class="text-center">
                                                <td>@item.ItemName</td>
                                                <td><span class="badge bg-secondary">@item.TotalQuantity</span></td>
                                                <td class="fw-bold">@item.TotalRevenue.ToString("N0") ج</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>